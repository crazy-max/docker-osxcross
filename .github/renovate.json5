{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigestsToSemver",
    "helpers:githubDigestChangelogs"
  ],
  "enabledManagers": [
    "github-actions",
    "dockerfile",
    "custom.regex"
  ],
  "prHourlyLimit": 0,
  "minimumReleaseAge": "2 days",
  "internalChecksFilter": "strict",
  "vulnerabilityAlerts": {
    "enabled": true,
    "commitMessageSuffix": ""
  },
  "labels": ["kind/dependencies", "bot"],
  "semanticCommits": "disabled",
  "commitMessagePrefix": "deps{{#if isVulnerabilityAlert}}(security){{/if}}:",
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^Dockerfile$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>custom\\.macos-sdk) depName=(?<depName>\\S+)\\r?\\nARG OSX_SDK_VERSION=(?<currentValue>[\\d.]+)\\r?\\nARG OSX_SDK_SHA256=(?<currentDigest>[a-f0-9]{64})"
      ],
      "versioningTemplate": "loose"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^Dockerfile$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>git-refs) depName=(?<depName>\\S+) ref=(?<currentValue>\\S+)\\r?\\nARG OSX_CROSS_COMMIT=(?<currentDigest>[a-f0-9]{40})"
      ],
      "packageNameTemplate": "https://github.com/{{depName}}",
      "versioningTemplate": "exact"
    }
  ],
  "customDatasources": {
    "macos-sdk": {
      "defaultRegistryUrlTemplate": "https://api.github.com/repos/{{packageName}}/releases?per_page=100",
      "transformTemplates": [
        "{\
          'releases': [$map(\
            $[draft = false and prerelease = false and $match(tag_name, /^[0-9]+(\\.[0-9]+)*$/)],\
            function($r) { (\
              $asset := $r.assets[\
                name = 'MacOSX' & $r.tag_name & '.sdk.tar.xz' and\
                $match($string(digest), /^sha256:[a-f0-9]{64}$/)\
              ];\
              $exists($asset) ? {\
                'version': $r.tag_name,\
                'digest': $substringAfter($asset.digest, 'sha256:'),\
                'releaseTimestamp': $r.published_at,\
                'changelogUrl': $r.html_url\
              }\
            ) }\
          )],\
          'sourceUrl': 'https://github.com/joseluisq/macosx-sdks'\
        }"
      ]
    }
  },
  "packageRules": [
    {
      "matchManagers": ["dockerfile"],
      "matchPackageNames": ["debian"],
      "versioning": "debian"
    },
    {
      "matchManagers": ["dockerfile"],
      "matchPackageNames": ["ubuntu"],
      "versioning": "ubuntu"
    },
    {
      // Git refs do not provide a release timestamp.
      "matchDatasources": ["git-refs"],
      "minimumReleaseAge": null
    },
    {
      "matchFileNames": ["Dockerfile"],
      "commitMessagePrefix": "deps(dockerfile{{#if isVulnerabilityAlert}},security{{/if}}):"
    },
    {
      "matchFileNames": [".github/workflows/**"],
      "commitMessagePrefix": "deps(ci{{#if isVulnerabilityAlert}},security{{/if}}):"
    },
    {
      "matchUpdateTypes": ["major", "minor", "patch"],
      "commitMessageAction": "bump",
      "commitMessageTopic": "{{{depName}}}",
      "commitMessageExtra": "from {{{replace '^v' '' currentValue}}} to {{{replace '^v' '' newValue}}}"
    }
  ]
}
